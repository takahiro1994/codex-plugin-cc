+
+	constexpr LCID kLocaleUserDefault = 0x0400;
+	constexpr DWORD kNormIgnoreCase = 0x00000001;
+	constexpr int kCstrEqual = 2;
+	return CompareStringA(kLocaleUserDefault, kNormIgnoreCase, lpString1, -1, lpString2, -1) - kCstrEqual;
+}
