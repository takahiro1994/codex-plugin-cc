diff --git a/test/test_lstrcmpi.c b/test/test_lstrcmpi.c
new file mode 100644
index 0000000..5e8ba83
--- /dev/null
+++ b/test/test_lstrcmpi.c
@@ -0,0 +1,14 @@
+#include "test_assert.h"
+
+#include <windows.h>
+
+int main(void) {
+	TEST_CHECK_EQ(0, lstrcmpiA("", ""));
+	TEST_CHECK_EQ(0, lstrcmpiA("LINK.EXE", "link.exe"));
+	TEST_CHECK_EQ(0, lstrcmpiA("Kernel32", "kErNeL32"));
+	TEST_CHECK(lstrcmpiA("abc", "abd") < 0);
+	TEST_CHECK(lstrcmpiA("abd", "abc") > 0);
+	TEST_CHECK(lstrcmpiA("abc", "abcd") < 0);
+	TEST_CHECK(lstrcmpiA("abcd", "abc") > 0);
+	return 0;
+}
